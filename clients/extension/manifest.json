{
  "manifest_version": 3,
  "name": "TelePick",
  "short_name": "TelePick",
  "version": "1.0.0",
  "description": "Pick selected text and send it as a note to your Telegram chat",
  "permissions": ["storage", "activeTab", "tabs", "contextMenus"],
  "host_permissions": ["https://api.telegram.org/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/content.css"],
      "matches": ["<all_urls>"],
      "use_dynamic_url": true
    }
  ],
  "options_page": "src/options.html",
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
