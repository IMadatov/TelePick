<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TelePick.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
        x:Class="TelePick.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Settings Dashboard - TelePick"
        Width="900" Height="700"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        TransparencyLevelHint="Mica, AcrylicBlur"
        Background="Transparent">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBox.SettingsInput">
            <Setter Property="Background" Value="{DynamicResource SurfaceContainerLow}" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBox.SettingsInput:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryContainer}" />
        </Style>

        <Style Selector="Button.PrimaryAction">
            <Setter Property="Background" Value="{DynamicResource PrimaryContainer}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="0,16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.PrimaryAction:pointerover">
            <Setter Property="Background" Value="#209ddc" />
        </Style>

        <Style Selector="ListBox.SidebarNav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style Selector="ListBoxItem.SidebarItem">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ListBoxItem.SidebarItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem.SidebarItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#0DFFFFFF" />
        </Style>
        <Style Selector="ListBoxItem.SidebarItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryContainer}" />
        </Style>
        
        <Style Selector="ListBoxItem.SidebarItem TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
        </Style>
        <Style Selector="ListBoxItem.SidebarItem:selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryContainer}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ListBoxItem.SidebarItem materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
        </Style>
        <Style Selector="ListBoxItem.SidebarItem:selected materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryContainer}" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="256, *">
        
        <!-- Sidebar -->
        <Border Grid.Column="0" 
                Background="#F20C0E11" 
                BorderBrush="#0CFFFFFF" 
                BorderThickness="0,0,1,0" 
                Padding="12,40,12,12">
            <Grid RowDefinitions="Auto, *">
                <StackPanel Grid.Row="0" Margin="8,0,8,32">
                    <TextBlock Text="TelePick Pro" 
                               FontWeight="SemiBold" 
                               FontSize="18" 
                               Foreground="{DynamicResource Primary}" />
                    <TextBlock Text="V 2.1.0" 
                               FontSize="13" 
                               Foreground="{DynamicResource OnSurfaceVariant}" 
                               Opacity="0.7" />
                </StackPanel>

                <!-- Navigation -->
                <ListBox Grid.Row="1" Classes="SidebarNav" SelectedIndex="1">
                    <ListBoxItem Classes="SidebarItem">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <materialIcons:MaterialIcon Kind="ClipboardTextOutline" Width="20" Height="20" />
                            <TextBlock Text="Clipboard" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Classes="SidebarItem">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <materialIcons:MaterialIcon Kind="Send" Width="20" Height="20" />
                            <TextBlock Text="Telegram" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Classes="SidebarItem">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <materialIcons:MaterialIcon Kind="KeyboardOutline" Width="20" Height="20" />
                            <TextBlock Text="Hotkeys" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Classes="SidebarItem">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <materialIcons:MaterialIcon Kind="Tune" Width="20" Height="20" />
                            <TextBlock Text="Advanced" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Column="1" Background="{DynamicResource Background}">
            <ScrollViewer>
                <StackPanel Margin="32,48,32,32" MaxWidth="850" HorizontalAlignment="Stretch">
                    
                    <!-- Header -->
                    <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,32">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Telegram Integration" 
                                       FontWeight="Bold" 
                                       FontSize="24" 
                                       Foreground="{DynamicResource OnSurface}" 
                                       Margin="0,0,0,8" />
                            <TextBlock Text="Configure your connection to the TelePick bot for seamless clipboard syncing." 
                                       FontSize="15" 
                                       Foreground="{DynamicResource OnSurfaceVariant}" />
                        </StackPanel>
                        
                        <Border Grid.Column="1" 
                                Background="{DynamicResource SurfaceContainerHigh}" 
                                BorderBrush="#0CFFFFFF" 
                                BorderThickness="1" 
                                CornerRadius="16" 
                                Padding="12,6"
                                VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource PrimaryContainer}" />
                                <TextBlock Text="Connected" 
                                           FontSize="13" 
                                           Foreground="{DynamicResource OnSurface}" 
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Status Message Banner -->
                    <Border IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Background="{DynamicResource SurfaceContainerLow}"
                            BorderBrush="{Binding IsStatusError, Converter={StaticResource StatusColorConverter}}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12"
                            Margin="0,0,0,24">
                        <TextBlock Text="{Binding StatusMessage}" 
                                   Foreground="{DynamicResource OnSurface}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Grid ColumnDefinitions="*, *" Margin="0,0,0,24">
                        
                        <!-- Connection Settings Card -->
                        <Border Grid.Column="0" 
                                Background="#991C1F24"
                                BorderBrush="#1AFFFFFF"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="24"
                                Margin="0,0,12,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,24">
                                    <materialIcons:MaterialIcon Kind="Link" Width="24" Height="24" Foreground="{DynamicResource PrimaryContainer}" />
                                    <TextBlock Text="Bot Configuration" 
                                               FontWeight="SemiBold" 
                                               FontSize="18" 
                                               Foreground="{DynamicResource OnSurface}" 
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="Bot Token" 
                                           FontWeight="Bold" 
                                           FontSize="11" 
                                           LetterSpacing="0.05" 
                                           Foreground="{DynamicResource OnSurfaceVariant}" 
                                           Margin="0,0,0,8" />
                                <TextBox Classes="SettingsInput" 
                                         Text="{Binding BotToken}" 
                                         PasswordChar="*" 
                                         PlaceholderText="Enter Bot Token" 
                                         Margin="0,0,0,16" />

                                <TextBlock Text="Chat ID" 
                                           FontWeight="Bold" 
                                           FontSize="11" 
                                           LetterSpacing="0.05" 
                                           Foreground="{DynamicResource OnSurfaceVariant}" 
                                           Margin="0,0,0,8" />
                                <TextBox Classes="SettingsInput" 
                                         Text="{Binding ChatId}" 
                                         PlaceholderText="Enter Chat ID" 
                                         Margin="0,0,0,24" />

                                <Grid ColumnDefinitions="*, *">
                                    <Button Grid.Column="0" 
                                            Command="{Binding SaveSettingsCommand}"
                                            Background="{DynamicResource PrimaryContainer}"
                                            Foreground="White"
                                            FontWeight="SemiBold"
                                            FontSize="15"
                                            CornerRadius="8"
                                            Padding="0,12"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Cursor="Hand"
                                            Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="ContentSave" Width="18" Height="18" />
                                            <TextBlock Text="Save" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" 
                                            Content="Test" 
                                            Command="{Binding TestConnectionCommand}"
                                            Background="{DynamicResource SurfaceContainer}"
                                            Foreground="{DynamicResource OnSurface}"
                                            BorderBrush="#1AFFFFFF"
                                            BorderThickness="1"
                                            FontWeight="SemiBold"
                                            FontSize="15"
                                            CornerRadius="8"
                                            Padding="0,12"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Cursor="Hand"
                                            Margin="6,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Right Column Stack -->
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="24">
                            
                            <!-- Global Shortcut Card -->
                            <Border Background="#991C1F24"
                                    BorderBrush="#1AFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="24">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                        <materialIcons:MaterialIcon Kind="KeyboardOutline" Width="24" Height="24" Foreground="{DynamicResource OnSurfaceVariant}" />
                                        <TextBlock Text="Global Shortcut" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="18" 
                                                   Foreground="{DynamicResource OnSurface}" 
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    
                                    <TextBlock Text="Set the combination to instantly send your current clipboard to Telegram from anywhere." 
                                               FontSize="13" 
                                               Foreground="{DynamicResource OnSurfaceVariant}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,16" />

                                    <Button Command="{Binding ChangeHotkeyCommand}"
                                            Background="{DynamicResource SurfaceContainerLow}"
                                            BorderBrush="#1AFFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="24"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Cursor="Hand">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ClipboardPopupHotkey}" 
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="16"
                                                       Foreground="{DynamicResource OnSurface}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,0,8"/>
                                            <TextBlock Text="Click to record new shortcut"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource PrimaryContainer}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Primary Action Button -->
                            <Button Classes="PrimaryAction" Command="{Binding SendToTelegramCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="Send" Width="20" Height="20" />
                                    <TextBlock Text="Send Current Clipboard to Telegram" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
