<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TelePick.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:TelePick.Desktop.Views"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
        x:Class="TelePick.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Settings Dashboard - TelePick"
        Width="1050" Height="750"
        MinWidth="950" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        TransparencyLevelHint="Mica, AcrylicBlur"
        Background="Transparent">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBox.SettingsInput">
            <Setter Property="Background" Value="{DynamicResource SurfaceContainerLow}" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBox.SettingsInput:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryContainer}" />
        </Style>

        <Style Selector="Button.PrimaryAction">
            <Setter Property="Background" Value="{DynamicResource PrimaryContainer}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="0,16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.PrimaryAction:pointerover">
            <Setter Property="Background" Value="#209ddc" />
        </Style>

        <Style Selector="ListBox.SidebarNav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style Selector="ListBoxItem.SidebarItem">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ListBoxItem.SidebarItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem.SidebarItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#0DFFFFFF" />
        </Style>
        <Style Selector="ListBoxItem.SidebarItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryContainer}" />
        </Style>
        
        <Style Selector="ListBoxItem.SidebarItem TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
        </Style>
        <Style Selector="ListBoxItem.SidebarItem:selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryContainer}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ListBoxItem.SidebarItem materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
        </Style>
        <Style Selector="ListBoxItem.SidebarItem:selected materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryContainer}" />
        </Style>
        
        <!-- ToggleSwitch Style -->
        <Style Selector="ToggleSwitch">
            <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
            <Setter Property="OnContent" Value="{x:Null}" />
            <Setter Property="OffContent" Value="{x:Null}" />
        </Style>
        
        <!-- Custom ComboBox -->
        <Style Selector="ComboBox.SettingsCombo">
            <Setter Property="Background" Value="{DynamicResource SurfaceContainerLow}" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="256, *">
        
        <!-- Sidebar -->
        <Border Grid.Column="0" 
                Background="#F20C0E11" 
                BorderBrush="#0CFFFFFF" 
                BorderThickness="0,0,1,0" 
                Padding="12,40,12,12">
            <Grid RowDefinitions="Auto, *">
                <StackPanel Grid.Row="0" Margin="8,0,8,32">
                    <TextBlock Text="TelePick Pro" 
                               FontWeight="SemiBold" 
                               FontSize="18" 
                               Foreground="{DynamicResource Primary}" />
                    <TextBlock Text="V 2.1.0" 
                               FontSize="13" 
                               Foreground="{DynamicResource OnSurfaceVariant}" 
                               Opacity="0.7" />
                </StackPanel>

                <!-- Navigation -->
                <ListBox Grid.Row="1" Classes="SidebarNav" SelectedIndex="{Binding SelectedPageIndex}">
                    <ListBoxItem Classes="SidebarItem">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <materialIcons:MaterialIcon Kind="ClipboardTextOutline" Width="20" Height="20" />
                            <TextBlock Text="Clipboard" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Classes="SidebarItem">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <materialIcons:MaterialIcon Kind="Send" Width="20" Height="20" />
                            <TextBlock Text="Telegram" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Classes="SidebarItem">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <materialIcons:MaterialIcon Kind="KeyboardOutline" Width="20" Height="20" />
                            <TextBlock Text="Hotkeys" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Classes="SidebarItem">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <materialIcons:MaterialIcon Kind="Tune" Width="20" Height="20" />
                            <TextBlock Text="Advanced" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Column="1" Background="{DynamicResource Background}">
            <ScrollViewer>
                <Grid Margin="32,48,32,32" MaxWidth="850" HorizontalAlignment="Stretch">
                    
                    <!-- Clipboard Dashboard Page (Index 0) -->
                    <views:ClipboardDashboardView IsVisible="{Binding SelectedPageIndex, Converter={StaticResource EqualityConverter}, ConverterParameter=0}" />

                    <!-- Telegram Integration Page (Index 1) -->
                    <StackPanel IsVisible="{Binding SelectedPageIndex, Converter={StaticResource EqualityConverter}, ConverterParameter=1}">
                        
                        <!-- Header -->
                    <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,32">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Telegram Integration" 
                                       FontWeight="Bold" 
                                       FontSize="24" 
                                       Foreground="{DynamicResource OnSurface}" 
                                       Margin="0,0,0,8" />
                            <TextBlock Text="Configure your connection to the TelePick bot for seamless clipboard syncing." 
                                       FontSize="15" 
                                       Foreground="{DynamicResource OnSurfaceVariant}" />
                        </StackPanel>
                        
                        <Border Grid.Column="1" 
                                Background="{DynamicResource SurfaceContainerHigh}" 
                                BorderBrush="#0CFFFFFF" 
                                BorderThickness="1" 
                                CornerRadius="16" 
                                Padding="12,6"
                                VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource PrimaryContainer}" />
                                <TextBlock Text="Connected" 
                                           FontSize="13" 
                                           Foreground="{DynamicResource OnSurface}" 
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Status Message Banner -->
                    <Border IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Background="{DynamicResource SurfaceContainerLow}"
                            BorderBrush="{Binding IsStatusError, Converter={StaticResource StatusColorConverter}}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12"
                            Margin="0,0,0,24">
                        <TextBlock Text="{Binding StatusMessage}" 
                                   Foreground="{DynamicResource OnSurface}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Grid ColumnDefinitions="*, *" Margin="0,0,0,24">
                        
                        <!-- Connection Settings Card -->
                        <Border Grid.Column="0" 
                                Background="#991C1F24"
                                BorderBrush="#1AFFFFFF"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="24"
                                Margin="0,0,12,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,24">
                                    <materialIcons:MaterialIcon Kind="Link" Width="24" Height="24" Foreground="{DynamicResource PrimaryContainer}" />
                                    <TextBlock Text="Bot Configuration" 
                                               FontWeight="SemiBold" 
                                               FontSize="18" 
                                               Foreground="{DynamicResource OnSurface}" 
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="Bot Token" 
                                           FontWeight="Bold" 
                                           FontSize="11" 
                                           LetterSpacing="0.05" 
                                           Foreground="{DynamicResource OnSurfaceVariant}" 
                                           Margin="0,0,0,8" />
                                <TextBox Classes="SettingsInput" 
                                         Text="{Binding BotToken}" 
                                         PasswordChar="*" 
                                         PlaceholderText="Enter Bot Token" 
                                         Margin="0,0,0,16" />

                                <TextBlock Text="Chat ID" 
                                           FontWeight="Bold" 
                                           FontSize="11" 
                                           LetterSpacing="0.05" 
                                           Foreground="{DynamicResource OnSurfaceVariant}" 
                                           Margin="0,0,0,8" />
                                <TextBox Classes="SettingsInput" 
                                         Text="{Binding ChatId}" 
                                         PlaceholderText="Enter Chat ID" 
                                         Margin="0,0,0,24" />

                                <Grid ColumnDefinitions="*, *">
                                    <Button Grid.Column="0" 
                                            Command="{Binding SaveSettingsCommand}"
                                            Background="{DynamicResource PrimaryContainer}"
                                            Foreground="White"
                                            FontWeight="SemiBold"
                                            FontSize="15"
                                            CornerRadius="8"
                                            Padding="0,12"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Cursor="Hand"
                                            Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="ContentSave" Width="18" Height="18" />
                                            <TextBlock Text="Save" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" 
                                            Content="Test" 
                                            Command="{Binding TestConnectionCommand}"
                                            Background="{DynamicResource SurfaceContainer}"
                                            Foreground="{DynamicResource OnSurface}"
                                            BorderBrush="#1AFFFFFF"
                                            BorderThickness="1"
                                            FontWeight="SemiBold"
                                            FontSize="15"
                                            CornerRadius="8"
                                            Padding="0,12"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Cursor="Hand"
                                            Margin="6,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Right Column Stack -->
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="24">
                            
                            <!-- Global Shortcut Card -->
                            <Border Background="#991C1F24"
                                    BorderBrush="#1AFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="24">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                        <materialIcons:MaterialIcon Kind="KeyboardOutline" Width="24" Height="24" Foreground="{DynamicResource OnSurfaceVariant}" />
                                        <TextBlock Text="Global Shortcut" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="18" 
                                                   Foreground="{DynamicResource OnSurface}" 
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    
                                    <TextBlock Text="Set the combination to instantly send your current clipboard to Telegram from anywhere." 
                                               FontSize="13" 
                                               Foreground="{DynamicResource OnSurfaceVariant}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,16" />

                                    <Button Command="{Binding ChangeHotkeyCommand}" CommandParameter="ClipboardPopupHotkey"
                                            Background="{DynamicResource SurfaceContainerLow}"
                                            BorderBrush="#1AFFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="24"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Cursor="Hand">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ClipboardPopupHotkey}" 
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="16"
                                                       Foreground="{DynamicResource OnSurface}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,0,8"/>
                                            <TextBlock Text="Click to record new shortcut"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource PrimaryContainer}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Primary Action Button -->
                            <Button Classes="PrimaryAction" Command="{Binding SendToTelegramCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="Send" Width="20" Height="20" />
                                    <TextBlock Text="Send Current Clipboard to Telegram" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    </StackPanel>

                    <!-- Hotkeys Page (Index 2) -->
                    <StackPanel IsVisible="{Binding SelectedPageIndex, Converter={StaticResource EqualityConverter}, ConverterParameter=2}">
                        <!-- Header -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,32">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Global Hotkeys" 
                                           FontWeight="Bold" 
                                           FontSize="24" 
                                           Foreground="{DynamicResource OnSurface}" 
                                           Margin="0,0,0,8" />
                                <TextBlock Text="Configure keyboard shortcuts to trigger TelePick actions from anywhere in your operating system." 
                                           FontSize="15" 
                                           Foreground="{DynamicResource OnSurfaceVariant}"
                                           TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="8">
                            <TextBlock Text="CORE ACTIONS" 
                                       FontWeight="Bold" 
                                       FontSize="11" 
                                       LetterSpacing="0.05" 
                                       Foreground="{DynamicResource OnSurfaceVariant}" 
                                       Margin="8,16,8,8" />

                            <!-- Quick Paste Action -->
                            <Border Background="{DynamicResource SurfaceContainer}"
                                    BorderBrush="#0CFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Grid Grid.Column="0" ColumnDefinitions="Auto, *" Margin="0,0,16,0">
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="{DynamicResource SurfaceBright}" BorderBrush="#0CFFFFFF" BorderThickness="1" Margin="0,0,16,0">
                                            <materialIcons:MaterialIcon Kind="LightningBolt" Width="20" Height="20" Foreground="{DynamicResource OnSurface}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Open Quick Paste" FontWeight="SemiBold" FontSize="18" Foreground="{DynamicResource OnSurface}" />
                                            <TextBlock Text="Summons the clipboard overlay at your cursor position." FontSize="13" Foreground="{DynamicResource OnSurfaceVariant}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <Button Grid.Column="1" Command="{Binding ChangeHotkeyCommand}" CommandParameter="ClipboardPopupHotkey"
                                            Background="{DynamicResource SurfaceDim}" BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="1" CornerRadius="8" Padding="16,8" Cursor="Hand" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{Binding ClipboardPopupHotkey}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Foreground="{DynamicResource OnSurface}" VerticalAlignment="Center" />
                                            <Border Width="1" Height="16" Background="{DynamicResource OutlineVariant}" />
                                            <materialIcons:MaterialIcon Kind="Keyboard" Width="18" Height="18" Foreground="{DynamicResource OnSurfaceVariant}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Send to Telegram Action -->
                            <Border Background="{DynamicResource SurfaceContainer}"
                                    BorderBrush="#0CFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Grid Grid.Column="0" ColumnDefinitions="Auto, *" Margin="0,0,16,0">
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="{DynamicResource SurfaceBright}" BorderBrush="#0CFFFFFF" BorderThickness="1" Margin="0,0,16,0">
                                            <materialIcons:MaterialIcon Kind="Send" Width="20" Height="20" Foreground="{DynamicResource TertiaryContainer}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Send to Telegram" FontWeight="SemiBold" FontSize="18" Foreground="{DynamicResource OnSurface}" />
                                            <TextBlock Text="Instantly forward selected text or current clipboard to 'Saved Messages'." FontSize="13" Foreground="{DynamicResource OnSurfaceVariant}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <Button Grid.Column="1" Command="{Binding ChangeHotkeyCommand}" CommandParameter="SendToTelegramHotkey"
                                            Background="{DynamicResource SurfaceDim}" BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="1" CornerRadius="8" Padding="16,8" Cursor="Hand" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{Binding SendToTelegramHotkey}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Foreground="{DynamicResource OnSurface}" VerticalAlignment="Center" />
                                            <Border Width="1" Height="16" Background="{DynamicResource OutlineVariant}" />
                                            <materialIcons:MaterialIcon Kind="Keyboard" Width="18" Height="18" Foreground="{DynamicResource OnSurfaceVariant}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Global Search Action -->
                            <Border Background="{DynamicResource SurfaceContainer}"
                                    BorderBrush="#0CFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Grid Grid.Column="0" ColumnDefinitions="Auto, *" Margin="0,0,16,0">
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="{DynamicResource SurfaceBright}" BorderBrush="#0CFFFFFF" BorderThickness="1" Margin="0,0,16,0">
                                            <materialIcons:MaterialIcon Kind="Magnify" Width="20" Height="20" Foreground="{DynamicResource OnSurface}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Global Search" FontWeight="SemiBold" FontSize="18" Foreground="{DynamicResource OnSurface}" />
                                            <TextBlock Text="Open a spotlight-style search for your entire clipboard history." FontSize="13" Foreground="{DynamicResource OnSurfaceVariant}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <Button Grid.Column="1" Command="{Binding ChangeHotkeyCommand}" CommandParameter="GlobalSearchHotkey"
                                            Background="{DynamicResource SurfaceDim}" BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="1" CornerRadius="8" Padding="16,8" Cursor="Hand" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{Binding GlobalSearchHotkey}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Foreground="{DynamicResource OnSurface}" VerticalAlignment="Center" />
                                            <Border Width="1" Height="16" Background="{DynamicResource OutlineVariant}" />
                                            <materialIcons:MaterialIcon Kind="Keyboard" Width="18" Height="18" Foreground="{DynamicResource OnSurfaceVariant}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <TextBlock Text="DATA MANAGEMENT" 
                                       FontWeight="Bold" 
                                       FontSize="11" 
                                       LetterSpacing="0.05" 
                                       Foreground="{DynamicResource OnSurfaceVariant}" 
                                       Margin="8,24,8,8" />

                            <!-- Clear History Action -->
                            <Border Background="{DynamicResource SurfaceContainer}"
                                    BorderBrush="#0CFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Grid Grid.Column="0" ColumnDefinitions="Auto, *" Margin="0,0,16,0">
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="{DynamicResource SurfaceBright}" BorderBrush="#0CFFFFFF" BorderThickness="1" Margin="0,0,16,0">
                                            <materialIcons:MaterialIcon Kind="DeleteSweep" Width="20" Height="20" Foreground="{DynamicResource Error}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Clear History" FontWeight="SemiBold" FontSize="18" Foreground="{DynamicResource OnSurface}" />
                                            <TextBlock Text="Purge all unpinned clipboard entries immediately." FontSize="13" Foreground="{DynamicResource OnSurfaceVariant}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <Button Grid.Column="1" Command="{Binding ChangeHotkeyCommand}" CommandParameter="ClearHistoryHotkey"
                                            Background="{DynamicResource SurfaceDim}" BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="1" CornerRadius="8" Padding="16,8" Cursor="Hand" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{Binding ClearHistoryHotkey}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Foreground="{DynamicResource OnSurface}" VerticalAlignment="Center" />
                                            <Border Width="1" Height="16" Background="{DynamicResource OutlineVariant}" />
                                            <materialIcons:MaterialIcon Kind="PlusCircle" Width="18" Height="18" Foreground="{DynamicResource OnSurfaceVariant}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Pause Monitoring Action -->
                            <Border Background="{DynamicResource SurfaceContainer}"
                                    BorderBrush="#0CFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Grid Grid.Column="0" ColumnDefinitions="Auto, *" Margin="0,0,16,0">
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="{DynamicResource SurfaceBright}" BorderBrush="#0CFFFFFF" BorderThickness="1" Margin="0,0,16,0">
                                            <materialIcons:MaterialIcon Kind="PauseCircle" Width="20" Height="20" Foreground="{DynamicResource OnSurface}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Pause Monitoring" FontWeight="SemiBold" FontSize="18" Foreground="{DynamicResource OnSurface}" />
                                            <TextBlock Text="Temporarily stop TelePick from recording new clipboard copies." FontSize="13" Foreground="{DynamicResource OnSurfaceVariant}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <Button Grid.Column="1" Command="{Binding ChangeHotkeyCommand}" CommandParameter="PauseMonitoringHotkey"
                                            Background="{DynamicResource SurfaceDim}" BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="1" CornerRadius="8" Padding="16,8" Cursor="Hand" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{Binding PauseMonitoringHotkey}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Foreground="{DynamicResource OnSurface}" VerticalAlignment="Center" />
                                            <Border Width="1" Height="16" Background="{DynamicResource OutlineVariant}" />
                                            <materialIcons:MaterialIcon Kind="Keyboard" Width="18" Height="18" Foreground="{DynamicResource OnSurfaceVariant}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </StackPanel>

                    <!-- Advanced Settings Page (Index 3) -->
                    <StackPanel IsVisible="{Binding SelectedPageIndex, Converter={StaticResource EqualityConverter}, ConverterParameter=3}">
                        <!-- Header -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,32">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Advanced Settings" 
                                           FontWeight="Bold" 
                                           FontSize="24" 
                                           Foreground="{DynamicResource OnSurface}" 
                                           Margin="0,0,0,8" />
                                <TextBlock Text="Manage system integration and core technical preferences." 
                                           FontSize="15" 
                                           Foreground="{DynamicResource OnSurfaceVariant}" />
                            </StackPanel>
                            
                            <Button Grid.Column="1" 
                                    Content="Apply Changes" 
                                    Command="{Binding SaveSettingsCommand}"
                                    Background="{DynamicResource PrimaryContainer}"
                                    Foreground="{DynamicResource OnPrimary}"
                                    FontWeight="SemiBold"
                                    FontSize="15"
                                    CornerRadius="8"
                                    Padding="20,10"
                                    VerticalAlignment="Bottom"
                                    Cursor="Hand" />
                        </Grid>

                        <Grid ColumnDefinitions="2*, 1*" Margin="0,0,0,24" ColumnSpacing="24">
                            
                            <!-- System Integration Module -->
                            <Border Grid.Column="0" 
                                    Background="#991C1F24"
                                    BorderBrush="#1AFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="24">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
                                        <materialIcons:MaterialIcon Kind="Cog" Width="24" Height="24" Foreground="{DynamicResource Primary}" />
                                        <TextBlock Text="System Integration" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="18" 
                                                   Foreground="{DynamicResource OnSurface}" 
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    
                                    <Border BorderBrush="#0CFFFFFF" BorderThickness="0,0,0,1" Margin="0,0,0,16" Padding="0,0,0,16">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Launch on Startup" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource OnSurface}" Margin="0,0,0,4" />
                                                <TextBlock Text="Automatically start TelePick in the background when your system boots." FontSize="13" Foreground="{DynamicResource OnSurfaceVariant}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding LaunchOnStartup}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    
                                    <Border BorderBrush="#0CFFFFFF" BorderThickness="0,0,0,0" Padding="0,0,0,0">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Sync Across Devices" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource OnSurface}" Margin="0,0,0,4" />
                                                <TextBlock Text="Keep your clipboard history and snippets synchronized via Telegram secure cloud." FontSize="13" Foreground="{DynamicResource OnSurfaceVariant}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding SyncAcrossDevices}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Data Limits Module -->
                            <Border Grid.Column="1" 
                                    Background="#991C1F24"
                                    BorderBrush="#1AFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="24">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
                                        <materialIcons:MaterialIcon Kind="Memory" Width="24" Height="24" Foreground="{DynamicResource Primary}" />
                                        <TextBlock Text="Data Limits" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="18" 
                                                   Foreground="{DynamicResource OnSurface}" 
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock Text="Clipboard History Limit" 
                                               FontWeight="SemiBold" 
                                               FontSize="13" 
                                               Foreground="{DynamicResource OnSurface}" 
                                               Margin="0,0,0,8" />
                                    <ComboBox Classes="SettingsCombo" SelectedItem="{Binding HistoryLimit}" Margin="0,0,0,4">
                                        <ComboBoxItem Content="50" />
                                        <ComboBoxItem Content="100" />
                                        <ComboBoxItem Content="500" />
                                        <ComboBoxItem Content="1000" />
                                        <ComboBoxItem Content="unlimited" />
                                    </ComboBox>
                                    <TextBlock Text="Higher limits increase RAM usage." 
                                               FontSize="11" 
                                               Foreground="{DynamicResource OnSurfaceVariant}" 
                                               Margin="0,0,0,24" />

                                    <TextBlock Text="Maintenance" 
                                               FontWeight="SemiBold" 
                                               FontSize="13" 
                                               Foreground="{DynamicResource OnSurface}" 
                                               Margin="0,0,0,12" />
                                    <Button Command="{Binding ClearLocalCacheCommand}"
                                            Background="{DynamicResource SurfaceContainerHighest}"
                                            Foreground="{DynamicResource OnSurface}"
                                            BorderBrush="#0CFFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16,10"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <materialIcons:MaterialIcon Kind="DeleteSweep" Width="18" Height="18" />
                                            <TextBlock Text="Clear Local Cache" VerticalAlignment="Center" FontSize="13" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Developer Options Module -->
                        <Border Background="#991C1F24"
                                BorderBrush="#1AFFFFFF"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="24">
                            <StackPanel>
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="Terminal" Width="24" Height="24" Foreground="{DynamicResource TertiaryContainer}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Developer Options" FontWeight="SemiBold" FontSize="18" Foreground="{DynamicResource OnSurface}" />
                                        <TextBlock Text="Debug logging and experimental features." FontSize="13" Foreground="{DynamicResource OnSurfaceVariant}" />
                                    </StackPanel>
                                </Grid>
                                
                                <Border BorderBrush="#0CFFFFFF" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,16,0,0">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Grid.Column="0" Text="Enable Verbose Logging" FontFamily="{StaticResource MonoFontFamily}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource OnSurface}" VerticalAlignment="Center" />
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding VerboseLogging}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                
                                <Border Background="{DynamicResource SurfaceContainerLowest}" 
                                        BorderBrush="#0CFFFFFF" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="12" 
                                        Margin="0,16,0,0"
                                        IsVisible="{Binding VerboseLogging}">
                                    <TextBlock Text="> TelePick Engine v1.2.0 initialized.&#x0a;> Loading user config... OK.&#x0a;> Connecting to local IPC socket..." 
                                               FontFamily="{StaticResource MonoFontFamily}" 
                                               FontSize="12" 
                                               Foreground="{DynamicResource OnSurfaceVariant}" />
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
