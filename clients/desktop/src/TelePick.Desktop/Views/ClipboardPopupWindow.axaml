<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TelePick.Desktop.ViewModels"
        xmlns:m="using:TelePick.Desktop.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="600"
        x:Class="TelePick.Desktop.Views.ClipboardPopupWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="TelePick Clipboard"
        Width="480" Height="600"
        WindowDecorations="None"
        TransparencyLevelHint="Mica, AcrylicBlur"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- Translucent surface for glassmorphic window backing -->
        <SolidColorBrush x:Key="SurfaceContainerHigh" Color="#E6282A2D" />
        <SolidColorBrush x:Key="ChipSelectedBackground" Color="#262AABEE" />
    </Window.Resources>

    <Window.Styles>
        <!-- TextBox SearchBox Styles -->
        <Style Selector="TextBox.SearchBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceContainerLow}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariant}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
            <Setter Property="Padding" Value="4,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.SearchBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource Outline}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceContainer}" />
        </Style>
        <Style Selector="TextBox.SearchBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceContainerHigh}" />
        </Style>
        <Style Selector="TextBox.SearchBox /template/ TextBlock#PART_PlaceholderText">
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>

        <!-- Filter Chip RadioButton Styles -->
        <Style Selector="RadioButton.FilterChip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariant}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          RecognizesAccessKey="True"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.FilterChip:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceBright}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Outline}" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
        </Style>
        <Style Selector="RadioButton.FilterChip:checked">
            <Setter Property="Background" Value="{StaticResource ChipSelectedBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
            <Setter Property="Foreground" Value="{DynamicResource Primary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="RadioButton.FilterChip:checked:pointerover">
            <Setter Property="Background" Value="#332AABEE" />
            <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
            <Setter Property="Foreground" Value="{DynamicResource Primary}" />
        </Style>

        <!-- ListBox & ListBoxItem Styles -->
        <Style Selector="ListBox">
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- ItemCard Container -->
        <Style Selector="ListBoxItem Border.ItemCard">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariant}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceContainerLow}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem:pointerover Border.ItemCard">
            <Setter Property="Background" Value="{DynamicResource SurfaceContainer}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Outline}" />
        </Style>
        <Style Selector="ListBoxItem:selected Border.ItemCard">
            <Setter Property="Background" Value="{DynamicResource SurfaceContainerHigh}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
        </Style>

        <!-- Quick Actions Panel & Hover State -->
        <Style Selector="StackPanel.QuickActions">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem:pointerover StackPanel.QuickActions">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="ListBoxItem:selected StackPanel.QuickActions">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>

        <!-- Timestamp Fade on Hover -->
        <Style Selector="StackPanel.ItemTimestamp">
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem:pointerover StackPanel.ItemTimestamp">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="ListBoxItem:selected StackPanel.ItemTimestamp">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <!-- Quick Action Buttons -->
        <Style Selector="Button.QuickActionButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.QuickActionButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceBright}" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
        </Style>
        <Style Selector="Button.QuickActionButton.DeleteButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource ErrorContainer}" />
            <Setter Property="Foreground" Value="{DynamicResource Error}" />
        </Style>
    </Window.Styles>

    <Border BorderBrush="{DynamicResource OutlineVariant}" 
            BorderThickness="1" 
            CornerRadius="12" 
            ClipToBounds="True" 
            Background="{DynamicResource SurfaceContainerHigh}"
            BoxShadow="0 8 32 0 #40000000">
        <Grid RowDefinitions="Auto, *, Auto">
            <!-- Header Area (Search and Filters) -->
            <Border Grid.Row="0" 
                    Background="Transparent"
                    BorderBrush="{DynamicResource OutlineVariant}" 
                    BorderThickness="0,0,0,1" 
                    Padding="16,14,16,12">
                <StackPanel Spacing="10">
                    <!-- Search Input -->
                    <TextBox Classes="SearchBox" 
                             PlaceholderText="Search clipboard..."
                             Text="{Binding SearchText, Mode=TwoWay}"
                             TabIndex="1">
                        <TextBox.InnerLeftContent>
                            <materialIcons:MaterialIcon Kind="Magnify" 
                                                        Width="18" 
                                                        Height="18" 
                                                        Margin="10,0,6,0" 
                                                        Foreground="{DynamicResource OnSurfaceVariant}" />
                        </TextBox.InnerLeftContent>
                        <TextBox.InnerRightContent>
                            <Border Background="{DynamicResource SurfaceVariant}"
                                    Opacity="0.7"
                                    BorderBrush="{DynamicResource OutlineVariant}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="5,2"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="⌘K" 
                                           FontSize="10" 
                                           FontFamily="{StaticResource MonoFontFamily}" 
                                           Foreground="{DynamicResource OnSurfaceVariant}" 
                                           VerticalAlignment="Center" />
                            </Border>
                        </TextBox.InnerRightContent>
                    </TextBox>

                    <!-- Filter Chips -->
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <RadioButton Classes="FilterChip" GroupName="ClipboardFilter" Content="All Items" IsChecked="True" Command="{Binding SetFilterCommand}" CommandParameter="All" />
                            <RadioButton Classes="FilterChip" GroupName="ClipboardFilter" Content="Text" Command="{Binding SetFilterCommand}" CommandParameter="Text" />
                            <RadioButton Classes="FilterChip" GroupName="ClipboardFilter" Content="Images" Command="{Binding SetFilterCommand}" CommandParameter="Images" />
                            <RadioButton Classes="FilterChip" GroupName="ClipboardFilter" Content="Files" Command="{Binding SetFilterCommand}" CommandParameter="Files" />
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- List (Clipboard Items Area) -->
            <ListBox x:Name="ClipboardListBox"
                     Grid.Row="1" 
                     ItemsSource="{Binding FilteredHistory}" 
                     Margin="8" 
                     Background="Transparent" 
                     KeyUp="OnListBoxKeyUp"
                     TabIndex="0">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="m:ClipboardItem">
                        <Border Classes="ItemCard" 
                                CornerRadius="8" 
                                Padding="10,8" 
                                Margin="0,2" 
                                Tapped="OnItemTapped">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <!-- Type Icon / Thumbnail -->
                                <Border Grid.Column="0" 
                                        Width="38" 
                                        Height="38" 
                                        CornerRadius="6" 
                                        Background="{DynamicResource SurfaceVariant}" 
                                        Margin="0,0,10,0" 
                                        ClipToBounds="True"
                                        VerticalAlignment="Center">
                                    <Panel>
                                        <Image Source="{Binding Thumbnail}" 
                                               Stretch="UniformToFill" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center" 
                                               IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        <materialIcons:MaterialIcon Kind="{Binding IconKind}" 
                                                                    Width="20" 
                                                                    Height="20" 
                                                                    Foreground="{DynamicResource Primary}" 
                                                                    HorizontalAlignment="Center" 
                                                                    VerticalAlignment="Center" 
                                                                    IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}" />
                                    </Panel>
                                </Border>

                                <!-- Item Details (Title, Preview) -->
                                <StackPanel Grid.Column="1" 
                                            VerticalAlignment="Center" 
                                            Spacing="2">
                                    <TextBlock Text="{Binding Title}" 
                                               FontWeight="SemiBold" 
                                               FontSize="13" 
                                               Foreground="{DynamicResource OnSurface}" 
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding PreviewText}" 
                                               FontSize="12" 
                                               Foreground="{DynamicResource OnSurfaceVariant}" 
                                               TextTrimming="CharacterEllipsis" 
                                               MaxLines="2" 
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Right Column: Timestamp (idle) and Quick Actions (hover/selected) -->
                                <Panel Grid.Column="2" 
                                       VerticalAlignment="Center" 
                                       Margin="6,0,0,0">
                                    <!-- Timestamp & Pin Indicator (Visible when idle) -->
                                    <StackPanel Classes="ItemTimestamp" 
                                                Orientation="Horizontal" 
                                                Spacing="4" 
                                                VerticalAlignment="Center" 
                                                HorizontalAlignment="Right">
                                        <materialIcons:MaterialIcon Kind="Pin" 
                                                                    Width="14" 
                                                                    Height="14" 
                                                                    Foreground="{DynamicResource Primary}" 
                                                                    IsVisible="{Binding IsPinned}" 
                                                                    VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding FormattedTimestamp}" 
                                                   FontSize="11" 
                                                   FontFamily="{StaticResource MonoFontFamily}" 
                                                   Foreground="{DynamicResource OnSurfaceVariant}" 
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Quick Actions Bar (Visible on hover/selected) -->
                                    <StackPanel Classes="QuickActions" 
                                                Orientation="Horizontal" 
                                                Spacing="2" 
                                                VerticalAlignment="Center" 
                                                HorizontalAlignment="Right">
                                        <Button Classes="QuickActionButton" 
                                                ToolTip.Tip="Pin to top" 
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TogglePinItemCommand}" 
                                                CommandParameter="{Binding}">
                                            <Panel>
                                                <materialIcons:MaterialIcon Kind="Pin" Width="15" Height="15" Foreground="{DynamicResource Primary}" IsVisible="{Binding IsPinned}" />
                                                <materialIcons:MaterialIcon Kind="PinOutline" Width="15" Height="15" IsVisible="{Binding !IsPinned}" />
                                            </Panel>
                                        </Button>
                                        <Button Classes="QuickActionButton" 
                                                ToolTip.Tip="Send to Telegram" 
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShareClipboardItemCommand}" 
                                                CommandParameter="{Binding}">
                                            <materialIcons:MaterialIcon Kind="SendOutline" Width="15" Height="15" />
                                        </Button>
                                        <Button Classes="QuickActionButton DeleteButton" 
                                                ToolTip.Tip="Delete item" 
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteClipboardItemCommand}" 
                                                CommandParameter="{Binding}">
                                            <materialIcons:MaterialIcon Kind="DeleteOutline" Width="15" Height="15" />
                                        </Button>
                                    </StackPanel>
                                </Panel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Footer / Status Bar Area -->
            <Border Grid.Row="2" 
                    Background="{DynamicResource SurfaceContainerLowest}" 
                    BorderBrush="{DynamicResource OutlineVariant}" 
                    BorderThickness="0,1,0,0" 
                    Padding="16,8">
                <Grid ColumnDefinitions="*, Auto">
                    <!-- Status -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Primary}" VerticalAlignment="Center" />
                        <TextBlock Text="TelePick • Synced" 
                                   FontSize="11" 
                                   FontFamily="{StaticResource MonoFontFamily}" 
                                   Foreground="{DynamicResource OnSurfaceVariant}" 
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Actions / Settings -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Background="Transparent" 
                                BorderThickness="0" 
                                Padding="4" 
                                Cursor="Hand">
                            <materialIcons:MaterialIcon Kind="CogOutline" Width="16" Height="16" Foreground="{DynamicResource OnSurfaceVariant}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
