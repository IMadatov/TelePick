<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TelePick.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="600"
        x:Class="TelePick.Desktop.Views.ClipboardPopupWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="TelePick Clipboard"
        Width="480" Height="600"
        WindowDecorations="None"
        TransparencyLevelHint="Mica, AcrylicBlur"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- Translucent surface for glassmorphic window backing -->
        <SolidColorBrush x:Key="SurfaceContainerHigh" Color="#E6282A2D" />
        <SolidColorBrush x:Key="ChipSelectedBackground" Color="#262AABEE" />
    </Window.Resources>

    <Window.Styles>
        <!-- TextBox SearchBox Styles -->
        <Style Selector="TextBox.SearchBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceContainerLow}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariant}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
            <Setter Property="Padding" Value="4,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.SearchBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource Outline}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceContainer}" />
        </Style>
        <Style Selector="TextBox.SearchBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceContainerHigh}" />
        </Style>
        <Style Selector="TextBox.SearchBox /template/ TextBlock#PART_PlaceholderText">
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>

        <!-- Filter Chip RadioButton Styles -->
        <Style Selector="RadioButton.FilterChip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariant}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          RecognizesAccessKey="True"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.FilterChip:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceBright}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Outline}" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
        </Style>
        <Style Selector="RadioButton.FilterChip:checked">
            <Setter Property="Background" Value="{StaticResource ChipSelectedBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
            <Setter Property="Foreground" Value="{DynamicResource Primary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="RadioButton.FilterChip:checked:pointerover">
            <Setter Property="Background" Value="#332AABEE" />
            <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
            <Setter Property="Foreground" Value="{DynamicResource Primary}" />
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style Selector="ListBoxItem Border.ItemCard">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariant}" />
        </Style>
        <Style Selector="ListBoxItem:selected Border.ItemCard">
            <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Styles>

    <Border BorderBrush="{DynamicResource OutlineVariant}" 
            BorderThickness="1" 
            CornerRadius="12" 
            ClipToBounds="True" 
            Background="{DynamicResource SurfaceContainerHigh}"
            BoxShadow="0 8 32 0 #40000000">
        <Grid RowDefinitions="Auto, *, Auto">
            <!-- Header Area (Search and Filters) -->
            <Border Grid.Row="0" 
                    Background="Transparent"
                    BorderBrush="{DynamicResource OutlineVariant}" 
                    BorderThickness="0,0,0,1" 
                    Padding="16,14,16,12">
                <StackPanel Spacing="10">
                    <!-- Search Input -->
                    <TextBox Classes="SearchBox" 
                             PlaceholderText="Search clipboard...">
                        <TextBox.InnerLeftContent>
                            <materialIcons:MaterialIcon Kind="Magnify" 
                                                        Width="18" 
                                                        Height="18" 
                                                        Margin="10,0,6,0" 
                                                        Foreground="{DynamicResource OnSurfaceVariant}" />
                        </TextBox.InnerLeftContent>
                        <TextBox.InnerRightContent>
                            <Border Background="{DynamicResource SurfaceVariant}"
                                    Opacity="0.7"
                                    BorderBrush="{DynamicResource OutlineVariant}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="5,2"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="⌘K" 
                                           FontSize="10" 
                                           FontFamily="{StaticResource MonoFontFamily}" 
                                           Foreground="{DynamicResource OnSurfaceVariant}" 
                                           VerticalAlignment="Center" />
                            </Border>
                        </TextBox.InnerRightContent>
                    </TextBox>

                    <!-- Filter Chips -->
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <RadioButton Classes="FilterChip" GroupName="ClipboardFilter" Content="All Items" IsChecked="True" />
                            <RadioButton Classes="FilterChip" GroupName="ClipboardFilter" Content="Text" />
                            <RadioButton Classes="FilterChip" GroupName="ClipboardFilter" Content="Images" />
                            <RadioButton Classes="FilterChip" GroupName="ClipboardFilter" Content="Files" />
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- List (Clipboard Items Area) -->
            <ListBox Grid.Row="1" 
                     ItemsSource="{Binding History}" 
                     Margin="8" 
                     Background="Transparent" 
                     KeyUp="OnListBoxKeyUp">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="ItemCard" Background="{DynamicResource SurfaceContainerLow}" CornerRadius="8" Padding="10" Margin="0,2" Tapped="OnItemTapped">
                            <Grid ColumnDefinitions="Auto, *">
                                <Panel Grid.Column="0" Width="40" Height="40" Margin="0,0,10,0">
                                    <Image Source="{Binding Thumbnail}" MaxWidth="40" MaxHeight="40" IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <materialIcons:MaterialIcon Kind="{Binding IconKind}" Width="24" Height="24" IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}" Foreground="{DynamicResource OnSurfaceVariant}" />
                                </Panel>
                                <TextBlock Grid.Column="1" Text="{Binding PreviewText}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="40" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource OnSurface}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Footer / Status Bar Area -->
            <Border Grid.Row="2" 
                    Background="{DynamicResource SurfaceContainerLowest}" 
                    BorderBrush="{DynamicResource OutlineVariant}" 
                    BorderThickness="0,1,0,0" 
                    Padding="16,8">
                <Grid ColumnDefinitions="*, Auto">
                    <!-- Status -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Primary}" VerticalAlignment="Center" />
                        <TextBlock Text="TelePick • Synced" 
                                   FontSize="11" 
                                   FontFamily="{StaticResource MonoFontFamily}" 
                                   Foreground="{DynamicResource OnSurfaceVariant}" 
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Actions / Settings -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Background="Transparent" 
                                BorderThickness="0" 
                                Padding="4" 
                                Cursor="Hand">
                            <materialIcons:MaterialIcon Kind="CogOutline" Width="16" Height="16" Foreground="{DynamicResource OnSurfaceVariant}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
