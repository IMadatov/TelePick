<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="TelePick.Desktop.Views.HotkeyRecorderWindow"
        Title="Record Hotkey"
        Width="420" Height="360"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Mica, AcrylicBlur"
        WindowDecorations="None"
        KeyDown="OnKeyDown"
        KeyUp="OnKeyUp">

    <Window.Resources>
        <SolidColorBrush x:Key="Background" Color="#F20C0E11" />
        <SolidColorBrush x:Key="SurfaceContainerHigh" Color="#282A2D" />
        <SolidColorBrush x:Key="SurfaceContainerLow" Color="#1A1C1F" />
        <SolidColorBrush x:Key="Primary" Color="#89CEFF" />
        <SolidColorBrush x:Key="PrimaryContainer" Color="#2AABEE" />
        <SolidColorBrush x:Key="OnPrimaryContainer" Color="#003C58" />
        <SolidColorBrush x:Key="OnSurface" Color="#E2E2E6" />
        <SolidColorBrush x:Key="OnSurfaceVariant" Color="#BEC8D2" />
        <SolidColorBrush x:Key="Outline" Color="#88929B" />
        <SolidColorBrush x:Key="White5" Color="#0DFFFFFF" />
        <SolidColorBrush x:Key="White10" Color="#1AFFFFFF" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Inter, Arial, sans-serif" />
        </Style>
        
        <Style Selector="Button.ActionBtn">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        
        <Style Selector="Button.CancelBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
        </Style>
        <Style Selector="Button.CancelBtn:pointerover">
            <Setter Property="Background" Value="#1AFFFFFF" />
        </Style>
        
        <Style Selector="Button.SaveBtn">
            <Setter Property="Background" Value="{DynamicResource PrimaryContainer}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.SaveBtn:pointerover">
            <Setter Property="Background" Value="#209DDC" />
        </Style>
    </Window.Styles>

    <!-- Modal Container -->
    <Border Background="{DynamicResource Background}" 
            BorderBrush="{DynamicResource White10}" 
            BorderThickness="1" 
            CornerRadius="16" 
            ClipToBounds="True">
        <Grid RowDefinitions="Auto, *, Auto">
            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="24,24,24,16">
                <TextBlock Text="Set Global Shortcut" 
                           FontSize="18" 
                           FontWeight="SemiBold" 
                           Foreground="{DynamicResource OnSurface}" />
                <TextBlock Text="Press the key combination you want to use" 
                           FontSize="13" 
                           Foreground="{DynamicResource OnSurfaceVariant}" 
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Content Body -->
            <StackPanel Grid.Row="1" Margin="24,16,24,32" Spacing="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Listening Area -->
                <Border x:Name="ListeningBorder" 
                        Width="372" 
                        MinHeight="140" 
                        Background="{DynamicResource SurfaceContainerHigh}" 
                        BorderBrush="{DynamicResource Primary}" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="24"
                        BoxShadow="0 0 15 0 #1A2AABEE">
                    <!-- Note: Real pulse animations and gradient masks are complex in Avalonia XAML, using a solid border with box shadow as approximation -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                        <materialIcons:MaterialIcon x:Name="ListeningIcon" 
                                                    Kind="Keyboard" 
                                                    Width="42" 
                                                    Height="42" 
                                                    Foreground="{DynamicResource Primary}" />
                        <TextBlock x:Name="HotkeyDisplay" 
                                   Text="LISTENING..." 
                                   FontFamily="JetBrains Mono, Consolas, monospace" 
                                   FontSize="15" 
                                   FontWeight="Bold" 
                                   LetterSpacing="0.1" 
                                   Foreground="{DynamicResource Primary}" 
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Helper Text -->
                <TextBlock Text="Use combinations like CMD+Shift+C to avoid conflicts with system shortcuts." 
                           FontSize="13" 
                           Foreground="{DynamicResource Outline}" 
                           TextWrapping="Wrap" 
                           TextAlignment="Center" 
                           MaxWidth="280" />
            </StackPanel>

            <!-- Footer Actions -->
            <Border Grid.Row="2" 
                    Background="#801A1C1F" 
                    BorderBrush="{DynamicResource White5}" 
                    BorderThickness="0,1,0,0" 
                    Padding="24,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                    <Button Classes="ActionBtn CancelBtn" 
                            Content="Cancel" 
                            Click="OnCancelClick" />
                    <Button Classes="ActionBtn SaveBtn" 
                            Content="Save" 
                            Click="OnSaveClick" 
                            x:Name="SaveButton" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
